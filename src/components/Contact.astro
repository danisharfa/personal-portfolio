<section id="contact" class="py-20 px-4 sm:px-6 lg:px-8 bg-dark-surface">
  <div class="container mx-auto max-w-4xl">
    <h2 class="text-4xl sm:text-5xl font-bold text-white mb-4 text-center">
      Connect With <span class="text-accent">Me</span>
    </h2>
    <div class="w-20 h-1 bg-accent mx-auto mb-12"></div>

    <div class="flex justify-center gap-6">
      {
        socialLinks.slice(0, 4).map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            style={`--brand: ${social.color}`}
            class="group p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-(--brand) transition-all duration-300 transform hover:scale-110"
            aria-label={social.name}
          >
            <svg
              class="w-8 h-8 text-dark-text-muted group-hover:text-(--brand) transition-colors"
              fill="currentColor"
              viewBox={social.viewBox}
            >
              <path d={social.icon} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>
