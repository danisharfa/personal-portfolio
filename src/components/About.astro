<section id="about" class="py-20 px-4 sm:px-6 lg:px-8 bg-dark-surface">
  <div class="container mx-auto max-w-6xl">
    <h2 class="text-4xl sm:text-5xl font-bold text-white mb-4 text-center">
      About <span class="text-accent">Me</span>
    </h2>
    <div class="w-20 h-1 bg-accent mx-auto mb-12"></div>

    <div class="flex flex-col gap-12">
      <div class="space-y-6 max-w-3xl mx-auto text-center">
        <p class="text-lg text-dark-text-muted leading-relaxed">
          Full-Stack Developer with hands-on experience digitizing manual business workflows into
          web-based systems. Proficient in Next.js, NestJS, PostgreSQL, and Prisma ORM, with
          experience deploying applications on self-hosted servers and Google Cloud Platform.
        </p>
      </div>

      <div class="space-y-4">
        <h3 class="text-2xl font-semibold text-white mb-6 text-center">Skills & Technologies</h3>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Programming Languages:</span>
            <span class="text-dark-text-muted ml-2">JavaScript, TypeScript, Dart</span>
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Frontend:</span>
            <span class="text-dark-text-muted ml-2">Next.js, Shadcn UI</span>
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Backend:</span>
            <span class="text-dark-text-muted ml-2">Express.js, Next.js, NestJS, RESTful API, OpenAPI Specification</span>
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Database &amp; ORM:</span>
            <span class="text-dark-text-muted ml-2">Firestore (NoSQL), MySQL, PostgreSQL, Supabase, Neon, Prisma ORM</span>
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Mobile:</span>
            <span class="text-dark-text-muted ml-2">Flutter</span>
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Cloud &amp; DevOps:</span>
            <span class="text-dark-text-muted ml-2">Google Cloud Platform (Cloud Run, App Engine, Cloud Storage), Vercel, GitHub Actions</span>
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Tools:</span>
            <span class="text-dark-text-muted ml-2">Git, GitHub, Postman</span>
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Languages:</span>
            <span class="text-dark-text-muted ml-2">Indonesian (Native), English (Intermediate)</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
