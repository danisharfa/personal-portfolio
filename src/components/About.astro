<section id="about" class="py-20 px-4 sm:px-6 lg:px-8 bg-dark-surface">
  <div class="container mx-auto max-w-6xl">
    <h2 class="text-4xl sm:text-5xl font-bold text-white mb-4 text-center">
      About <span class="text-accent">Me</span>
    </h2>
    <div class="w-20 h-1 bg-accent mx-auto mb-12"></div>

    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <p class="text-lg text-dark-text-muted leading-relaxed">
          Full-Stack Developer with practical experience building scalable web applications using
          Next.js and NestJS. Strong focus on backend engineering, including RESTful API design and
          database architecture with PostgreSQL and Prisma ORM. Experienced in delivering end-to-end
          solutions through internship and academic projects, with additional exposure to cloud
          deployment on Google Cloud Platform and Vercel.
        </p>
      </div>

      <div class="space-y-4">
        <h3 class="text-2xl font-semibold text-white mb-6">Skills & Technologies</h3>
        <div class="grid grid-cols-2 gap-4">
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Frontend:</span>
            <span class="text-dark-text-muted ml-2">Next.js, shadcn/ui</span>
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Backend:</span>
            <span class="text-dark-text-muted ml-2">Express.js, Next.js, NestJS</span>
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Database:</span>
            <span class="text-dark-text-muted ml-2"
              >MySQL, PostgreSQL, Prisma ORM, Prisma Postgres, Supabase, Neon</span
            >
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Cloud & DevOps:</span>
            <span class="text-dark-text-muted ml-2"
              >• Google Cloud Platform (Cloud Run, App Engine, Cloud Storage, Firestore), Vercel</span
            >
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Design:</span>
            <span class="text-dark-text-muted ml-2">Canva, Figma, Draw.io</span>
          </div>
          <div
            class="flex flex-col p-4 bg-dark-bg rounded-lg border border-dark-border hover:border-accent transition-colors duration-200"
          >
            <span class="text-accent font-semibold">Tools:</span>
            <span class="text-dark-text-muted ml-2">Git, GitHub, Postman</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
